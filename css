 .container {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 80px;
    }
 .row {
  display: flex;
        justify-content: center;        
        align-items: flex-start;
        gap: 120px;
        margin-top: 80px;
    }
.box {
        width: 500px;
        height: 300px;
        border-radius: 30px;
        display: flex;
       align-items: center;
        overflow: hidden;
   
    }
  .box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .box video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
